# Bazel entry points for the numbered end-to-end shell suites.
#
# Design notes (why this is deliberately conservative):
#
#   * Only the CI-SAFE suites are wired as sh_test targets (the set from
#     tests/README.md). Suites that need a real UML kernel (01-04, 09) stay
#     on the ci.yml loop, which also owns the root-owned console-log
#     forensics that a Bazel sandbox cannot reproduce (internal/log hardens
#     containers/<id>/logs to 0700 root).
#   * tags = ["manual", "local", "exclusive"] (see pvm_suite.bzl):
#       - manual: `bazel test //...` skips these; they are opt-in via
#         `bazel test //tests:ci_safe` so an unprivileged dev machine (or
#         the Bazel CI job) is never broken by design-intended root skips.
#       - local: run outside the sandbox — the suites copy binaries, bind
#         127.0.0.1 ports, and write to PVM_*_ROOT temp dirs.
#       - exclusive: serialize; many suites share process-global state
#         (fixed-ish ports, the IPAM registry).
#   * The suites cd "$ROOT" (their own location's parent — inside runfiles
#     that is the workspace root of the runfiles tree), so every workspace
#     file they touch must be declared in `data` or Bazel will not
#     materialize it: uml/agentpvm.toml via //uml:agentpvm.toml.
#   * Prebuilt binaries are injected via AGENTPVM_BIN/UMLCTL_BIN pointing
#     at the runfiles copies of the //cmd binaries built by Bazel; the
#     suites' per-suite `go build` fallback then never runs, which is what
#     makes these targets usable without a writable source tree.

load(":pvm_suite.bzl", "pvm_suites")

pvm_suites([
    # CI-safe set per tests/README.md. 30/31 run their unprivileged legs
    # only (root legs skip themselves); 34 skips without python3; 36
    # skips without node/npm. 02/03 are listed too — they assert CLI
    # parsing and cgroup fakefs paths, which need no privileges.
    "02_test_network_qos.sh",
    "03_test_cgroup_freeze.sh",
    "05_test_controlplane_api.sh",
