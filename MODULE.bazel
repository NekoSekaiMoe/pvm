module(
    name = "uml_container",
    version = "1.0.0",
)

bazel_dep(name = "rules_go", version = "0.46.0")
bazel_dep(name = "gazelle", version = "0.41.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.22.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_cilium_ebpf", "com_github_google_go_containerregistry", "com_github_iceber_iouring_go", "com_github_labstack_echo_v4", "com_github_vishvananda_netlink", "org_golang_x_sys")
