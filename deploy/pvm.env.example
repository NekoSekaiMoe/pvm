# PVM controller environment — copy to /etc/pvm/pvm.env (install.sh does this
# automatically) and EDIT BEFORE first start. Mode 0600, owner root:pvm.
#
# REQUIRED. Shared secret for the /api Bearer auth and the E2B-compat
# X-API-KEY auth. The API refuses to start without it. Generate with:
#   openssl rand -hex 32
API_SECRET=__GENERATE_ME__

# State / audit / cgroup roots (all under /var/lib/pvm by default).
PVM_STATE_ROOT=/var/lib/pvm/state
PVM_AUDIT_ROOT=/var/lib/pvm/audit
PVM_CGROUP_ROOT=/var/lib/pvm/cgroup

# Optional overrides:
# PVM_VOLUME_ROOT=/var/lib/pvm/volumes
# PVM_COW_ROOT=/var/lib/pvm/cow
# PVM_KERNEL=/var/lib/pvm/bin/linux
# PVM_APPROVAL_WEBHOOK_URL=https://hooks.example.invalid/pvm
# PVM_METRICS_NOAUTH=1        # expose /metrics without Bearer auth (careful!)
