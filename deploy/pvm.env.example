# PVM controller environment — copy to /etc/pvm/pvm.env (install.sh does this
# automatically) and EDIT BEFORE first start. Mode 0600, owner root:pvm.
#
# REQUIRED. Shared secret for the /api Bearer auth and the E2B-compat
# X-API-KEY auth. The API refuses to start without it. Generate with:
#   openssl rand -hex 32
API_SECRET=__GENERATE_ME__

# State / audit / cgroup roots (all under /var/lib/pvm by default).
PVM_STATE_ROOT=/var/lib/pvm/state
PVM_AUDIT_ROOT=/var/lib/pvm/audit
PVM_CGROUP_ROOT=/var/lib/pvm/cgroup

# Optional overrides:
# PVM_VOLUME_ROOT=/var/lib/pvm/volumes
# PVM_COW_ROOT=/var/lib/pvm/cow
# PVM_KERNEL=/var/lib/pvm/bin/linux
# PVM_APPROVAL_WEBHOOK_URL=https://hooks.example.invalid/pvm
# PVM_METRICS_NOAUTH=1        # expose /metrics without Bearer auth (careful!)

# --- Authentication (multi-key + optional delegation) ---
# Named API keys beyond the master API_SECRET. Entries: key, key:operator,
# or key:operator:tenant, comma- or newline-separated.
#PVM_API_KEYS=
# File form (one entry per line, '#' comments allowed).
#PVM_API_KEYS_FILE=/etc/pvm/api-keys
# External authenticator for unknown keys: HTTP 200 allows, anything else
# denies (401), an unreachable callback FAILS CLOSED (500).
#PVM_AUTH_CALLBACK_URL=

# --- Host mounts & volumes ---
# Whitelist for explicit host-directory volume mounts (comma-separated
# absolute prefixes). Empty = explicit host mounts are REFUSED.
#PVM_HOST_MOUNT_PREFIXES=/srv/shared
# Extra binary volume plugins: name=/abs/path entries.
#PVM_VOLUME_PLUGINS=
# Long-running RPC volume plugins over Unix sockets: name=/abs/socket.sock.
#PVM_VOLUME_RPC_PLUGINS=
# S3 driver (s3fs-backed): endpoint/region/path-style + AWS_* credentials.
#PVM_S3_ENDPOINT=
#PVM_S3_REGION=
#PVM_S3_PATH_STYLE=1

# --- Snapshots ---
# Chain CRIU memory dumps onto the previous snapshot (--track-mem): each
# snapshot writes only dirtied pages. Requires criu.
#PVM_SNAPSHOT_INCREMENTAL=1
