load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = ["e2b_server.go"],
    importpath = "uml-container/internal/api",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/approval",
        "//internal/artifact",
        "//internal/audit",
        "//internal/cgroup",
        "//internal/config",
        "//internal/container",
        "//internal/image",
        "//internal/lifecycle",
        "//internal/policy",
        "//internal/pool",
        "//internal/snapshot",
        "//internal/spec",
        "//internal/state",
        "//internal/template",
        "//internal/volume",
        "//webui",
        "@com_github_labstack_echo_v4//:echo",
        "@com_github_labstack_echo_v4//middleware",
    ],
)

go_test(
    name = "api_test",
    srcs = [
        "controlplanes_test.go",
        "e2b_server_test.go",
    ],
    embed = [":api"],
    deps = [
        "//internal/approval",
        "//internal/audit",
        "//internal/policy",
        "//internal/pool",
        "//internal/state",
    ],
)
