load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dnslearn",
    srcs = [
        "dnslearn.go",
        "proxy.go",
    ],
    importpath = "uml-container/internal/network/dnslearn",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/audit",
        "//internal/network",
        "//internal/network/egress",
        "@org_golang_x_net//dns/dnsmessage",
    ],
)

go_test(
    name = "dnslearn_test",
    srcs = ["dnslearn_test.go"],
    embed = [":dnslearn"],
    deps = [
        "//internal/audit",
        "//internal/network",
        "//internal/network/egress",
    ],
)
